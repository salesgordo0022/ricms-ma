# Copie para .env (local) ou configure como Variáveis de Ambiente no Railway.
# A chave NUNCA vai pro navegador — fica só no servidor.

# Groq (recomendada): https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (opcional — usada se a Groq não estiver configurada)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
